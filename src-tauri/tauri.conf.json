{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owl",
  "version": "0.1.4",
  "identifier": "com.github.schlambos.owl",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/owl"],
    "resources": {
      "resources/web": "./web",
      "resources/packages": "./packages",
      "resources/package.json": "./package.json",
      "resources/LICENSE": "./LICENSE"
    },
    "category": "DeveloperTool",
    "shortDescription": "Local control plane for OpenCode and OMO-Slim",
    "longDescription": "Owl gives you one place to configure your OpenCode + OMO-Slim agent team, understand which settings win, and inspect what OpenCode is running.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
