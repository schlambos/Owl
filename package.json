{
  "name": "omo-control-plane",
  "private": true,
  "version": "0.1.2",
  "license": "Apache-2.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev-supervisor.ts",
    "dev:server": "bun run --filter @omo/server dev",
    "dev:web": "bun run --filter @omo/web dev",
    "build": "bun run --filter @omo/shared build && bun run --filter @omo/server build && bun run --filter @omo/web build",
    "typecheck": "bun run --filter @omo/shared typecheck && bun run --filter @omo/server typecheck && bun run --filter @omo/web typecheck",
    "audit:omo-schema": "bun run scripts/audit-installed-omo-schema.ts",
    "test:telemetry-bridge": "bun run --filter @omo/telemetry-bridge test",
    "typecheck:telemetry-bridge": "bun run --filter @omo/telemetry-bridge typecheck",
    "desktop:prepare": "bun run scripts/prepare-desktop-assets.ts",
    "desktop:smoke": "bun run scripts/smoke-sidecar.ts",
    "desktop:verify": "bun run scripts/verify-desktop-bundle.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
